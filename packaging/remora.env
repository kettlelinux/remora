# /etc/remora/remora.env: read by remora-start (as root) before Remora starts. KEY=value lines.
# It must belong to root and not be writable by anyone else.

# The Game Mode user, as a name or uid (default 1000)
#REMORA_USER=deck

# Each plugin's settings, data and logs (default ~/homebrew of that user)
#UNPRIVILEGED_PATH=/home/deck/homebrew

# plugins/ and settings/loader.json (default: UNPRIVILEGED_PATH). A root-owned folder here keeps
# the user from adding plugins that would run as root.
#PRIVILEGED_PATH=/home/.remora

# HTTP and WebSocket port. Plugin bundles hardcode 1337, so only change it for testing.
#SERVER_PORT=1337

#LOG_LEVEL=INFO

# Seconds a plugin method call may take before it fails (0: no limit, as in Decky)
#REMORA_CALL_TIMEOUT=0

# 0: don't inject into Steam (the loader still serves plugins)
#REMORA_INJECT=1

# 0: don't reload "debug" plugins when their files change
#LIVE_RELOAD=1
